# Copy the values you need into Railway's Variables tab. Do not commit real secrets.

# Secret that member banks use to tokenise identifiers. Use a long random value.
CONSORTIUM_HMAC_KEY=replace-with-a-long-random-string
# Signs session cookies. Set it so sessions survive a restart.
SESSION_SECRET=replace-with-another-long-random-string
# Optional code asked for at sign-in. Leave empty for an open demo.
ACCESS_CODE=
# 1 shows Launch attack, Pause, Reset and the answer key. Set 0 outside demos.
DEMO_CONTROLS=1

MULERING_SEED=7
ACCOUNTS_PER_BANK=900
DATA_DIR=data
# Simulated minutes per real minute, and seconds between live updates.
STREAM_SPEED=60
STREAM_TICK_SECONDS=2
